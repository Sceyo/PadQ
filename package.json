  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "firebase emulators:start --only auth,firestore",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "firebase --config firebase.e2e.json emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:e2e": "firebase --config firebase.e2e.json emulators:exec --only auth,firestore \"playwright test\""
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.7.0",
    "next": "16.3.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^15.25.1",
    "postcss": "^8.5.8",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
