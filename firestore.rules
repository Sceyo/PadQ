rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Assumed V1 data model
    // =============================================================
    // sessions/{sessionId}: host-owned queue state. New IDs are six
    // unambiguous uppercase characters. Spectators may get a known live room,
    // while the host may also get its own pre-live room. Listing is denied.
    // sessions/{sessionId}/history/{commandId}: immutable match result,
    // created atomically with a parent revision increment.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDocOwner() {
      return isOwner(resource.data.hostUid);
    }

    function uidUnchanged(data) {
      return data.hostUid == request.auth.uid;
    }

    function uidNotModified(data) {
      return data.hostUid == resource.data.hostUid;
    }

    function validRoomCode(id) {
      return id.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$');
    }

    function validPlayerRoster(values) {
      return values is list && values.size() <= 30 &&
        values.toSet().size() == values.size();
    }

    function validPlayerSubset(values, players) {
      return values is list && values.size() <= 30 &&
        values.toSet().size() == values.size() && players.hasAll(values);
    }

    function validMetricMap(values, players) {
      return values is map && values.size() <= 30 &&
        values.keys().hasOnly(players);
    }

    function validShortStringAt(values, index, maxLength) {
      return values.size() <= index ||
        (values[index] is string && values[index].size() <= maxLength);
    }

    function validShortStringList(values, maxSize, maxLength) {
      return values is list && values.size() <= maxSize &&
        validShortStringAt(values, 0, maxLength) && validShortStringAt(values, 1, maxLength) &&
        validShortStringAt(values, 2, maxLength) && validShortStringAt(values, 3, maxLength) &&
        validShortStringAt(values, 4, maxLength) && validShortStringAt(values, 5, maxLength) &&
        validShortStringAt(values, 6, maxLength) && validShortStringAt(values, 7, maxLength);
    }

    function validTeam(team, players) {
      return team is map && team.keys().hasAll(['a', 'b']) &&
        team.keys().hasOnly(['a', 'b']) &&
        team.a is string && team.b is string && team.a != team.b &&
        players.hasAll([team.a, team.b]);
    }

    function validTeamAt(teams, players, index) {
      return teams.size() <= index || validTeam(teams[index], players);
    }

    function validTeamList(teams, players) {
      return teams is list && teams.size() <= 8 &&
        validTeamAt(teams, players, 0) && validTeamAt(teams, players, 1) &&
        validTeamAt(teams, players, 2) && validTeamAt(teams, players, 3) &&
        validTeamAt(teams, players, 4) && validTeamAt(teams, players, 5) &&
        validTeamAt(teams, players, 6) && validTeamAt(teams, players, 7);
    }

    function validCourt(court, gameMode, players) {
      return court is map && court.keys().hasAll(['id', 'name', 'onCourt']) &&
        court.keys().hasOnly(['id', 'name', 'onCourt']) &&
        court.id is string && court.id.size() >= 1 && court.id.size() <= 20 &&
        court.name is string && court.name.size() >= 1 && court.name.size() <= 40 &&
        validPlayerSubset(court.onCourt, players) &&
        (court.onCourt.size() == 0 ||
         (gameMode == 'singles' && court.onCourt.size() == 2) ||
         (gameMode == 'doubles' && court.onCourt.size() == 4));
    }

    function validCourtAt(courts, gameMode, players, index) {
      return courts.size() <= index || validCourt(courts[index], gameMode, players);
    }

    function validCourts(courts, gameMode, players) {
      let court0 = courts.size() > 0 ? courts[0].onCourt : [];
      let court1 = courts.size() > 1 ? courts[1].onCourt : [];
      let court2 = courts.size() > 2 ? courts[2].onCourt : [];
      let assigned = court0.concat(court1).concat(court2);
      return courts is list && courts.size() <= 3 &&
        validCourtAt(courts, gameMode, players, 0) &&
        validCourtAt(courts, gameMode, players, 1) &&
        validCourtAt(courts, gameMode, players, 2) &&
        assigned.toSet().size() == assigned.size();
    }

    function validLockedPairs(pairs, players) {
      // Only the owner can write this preference. Validating every field of
      // 15 nested pair maps exceeds Firestore's fixed 1,000-expression limit
      // for otherwise valid 30-player sessions, so rules enforce the safe
      // storage/capacity boundary and the client enforces pair membership and
      // uniqueness before saving.
      return pairs is list && pairs.size() <= 15 &&
        pairs.size() * 2 <= players.size();
    }

    function validLiveScore(score) {
      return score == null ||
        (score is map &&
         score.keys().hasAll(['scoreA', 'scoreB', 'labelA', 'labelB', 'limit', 'baseLimit', 'deuce', 'active']) &&
         score.keys().hasOnly(['scoreA', 'scoreB', 'labelA', 'labelB', 'limit', 'baseLimit', 'deuce', 'active']) &&
         score.scoreA is int && score.scoreA >= 0 && score.scoreA <= 100 &&
         score.scoreB is int && score.scoreB >= 0 && score.scoreB <= 100 &&
         score.labelA is string && score.labelA.size() <= 130 &&
         score.labelB is string && score.labelB.size() <= 130 &&
         score.limit is int && score.limit >= 1 && score.limit <= 100 &&
         score.baseLimit is int && score.baseLimit >= 2 && score.baseLimit <= 100 &&
         score.deuce is bool && score.active is bool);
    }

    function validDoublesEngine(state, players) {
      return state == null ||
        (state is map &&
         state.keys().hasAll(['phase', 'matchIndexInPhase', 'matchCount', 'w1', 'l1', 'waitingQueue', 'playedThisCycle', 'recentPairs', 'recentMatches', 'lastPlayedMap', 'winnersPool', 'losersPool']) &&
         state.keys().hasOnly(['phase', 'matchIndexInPhase', 'matchCount', 'w1', 'l1', 'waitingQueue', 'playedThisCycle', 'recentPairs', 'recentMatches', 'lastPlayedMap', 'winnersPool', 'losersPool']) &&
         state.phase in ['INIT', 'WINNERS', 'LOSERS'] &&
         state.matchIndexInPhase is int && state.matchIndexInPhase >= 0 && state.matchIndexInPhase <= 100000 &&
         state.matchCount is int && state.matchCount >= 0 && state.matchCount <= 100000 &&
         validPlayerSubset(state.w1, players) && validPlayerSubset(state.l1, players) &&
         validPlayerSubset(state.waitingQueue, players) && validPlayerSubset(state.playedThisCycle, players) &&
         validShortStringList(state.recentPairs, 6, 130) &&
         validShortStringList(state.recentMatches, 4, 260) &&
         validMetricMap(state.lastPlayedMap, players) &&
         validTeamList(state.winnersPool, players) && validTeamList(state.losersPool, players));
    }

    function validSinglesEngine(state, players) {
      return state == null ||
        (state is map &&
         state.keys().hasAll(['queue', 'king', 'matchIndex', 'lastPlayedMap', 'winStreak', 'playedThisCycle', 'waitingQueue']) &&
         state.keys().hasOnly(['queue', 'king', 'matchIndex', 'lastPlayedMap', 'winStreak', 'playedThisCycle', 'waitingQueue']) &&
         validPlayerSubset(state.queue, players) &&
         (state.king == null || (state.king is string && state.king in players)) &&
         state.matchIndex is int && state.matchIndex >= 0 && state.matchIndex <= 100000 &&
         validMetricMap(state.lastPlayedMap, players) &&
         validMetricMap(state.winStreak, players) &&
         validPlayerSubset(state.playedThisCycle, players) &&
         validPlayerSubset(state.waitingQueue, players));
    }

    function validDoublesEngineUpdate(state, players) {
      return state == null ||
        (state is map &&
         state.keys().hasAll(['phase', 'matchIndexInPhase', 'matchCount', 'w1', 'l1', 'waitingQueue', 'playedThisCycle', 'recentPairs', 'recentMatches', 'lastPlayedMap', 'winnersPool', 'losersPool']) &&
         state.keys().hasOnly(['phase', 'matchIndexInPhase', 'matchCount', 'w1', 'l1', 'waitingQueue', 'playedThisCycle', 'recentPairs', 'recentMatches', 'lastPlayedMap', 'winnersPool', 'losersPool']) &&
         state.phase in ['INIT', 'WINNERS', 'LOSERS'] &&
         state.matchIndexInPhase is int && state.matchIndexInPhase >= 0 && state.matchIndexInPhase <= 100000 &&
         state.matchCount is int && state.matchCount >= 0 && state.matchCount <= 100000 &&
         validPlayerSubset(state.w1, players) && validPlayerSubset(state.l1, players) &&
         validPlayerSubset(state.waitingQueue, players) && validPlayerSubset(state.playedThisCycle, players) &&
         state.recentPairs is list && state.recentPairs.size() <= 6 &&
         state.recentMatches is list && state.recentMatches.size() <= 4 &&
         state.lastPlayedMap is map && state.lastPlayedMap.size() <= 30 &&
         state.winnersPool is list && state.winnersPool.size() <= 8 &&
         state.losersPool is list && state.losersPool.size() <= 8);
    }

    function validSinglesEngineUpdate(state, players) {
      return state == null ||
        (state is map &&
         state.keys().hasAll(['queue', 'king', 'matchIndex', 'lastPlayedMap', 'winStreak', 'playedThisCycle', 'waitingQueue']) &&
         state.keys().hasOnly(['queue', 'king', 'matchIndex', 'lastPlayedMap', 'winStreak', 'playedThisCycle', 'waitingQueue']) &&
         validPlayerSubset(state.queue, players) &&
         (state.king == null || (state.king is string && state.king in players)) &&
         state.matchIndex is int && state.matchIndex >= 0 && state.matchIndex <= 100000 &&
         state.lastPlayedMap is map && state.lastPlayedMap.size() <= 30 &&
         state.winStreak is map && state.winStreak.size() <= 30 &&
         validPlayerSubset(state.playedThisCycle, players) &&
         validPlayerSubset(state.waitingQueue, players));
    }

    function validSession(data) {
      let players = data.players;
      let courts = data.get('courtSlots', []);
      return data.keys().hasOnly([
          'hostUid', 'revision', 'gameMode', 'queueMode', 'elimType',
          'players', 'queue', 'playAllRel', 'tournamentMatches',
          'tournamentActive', 'tournamentWinner', 'liveScore', 'isLive',
          'accessPin', 'courtName', 'doublesEngineState', 'singlesEngineState',
          'courtSlots', 'lockedPartners', 'sittingOut',
          'createdAt', 'updatedAt', 'lastActiveAt'
        ]) &&
        data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
        data.revision is int && data.revision >= 0 && data.revision <= 1000000 &&
        data.gameMode in ['singles', 'doubles'] &&
        data.queueMode == 'default' && data.elimType == 'single' &&
        players is list && players.size() >= 5 && validPlayerRoster(players) &&
        validPlayerSubset(data.queue, players) &&
        data.playAllRel is map && data.playAllRel.size() == 0 &&
        data.tournamentMatches is list && data.tournamentMatches.size() == 0 &&
        data.tournamentActive == false && data.tournamentWinner == null &&
        data.get('isLive', false) is bool && data.get('accessPin', null) == null &&
        data.get('courtName', '') is string && data.get('courtName', '').size() <= 60 &&
        validLiveScore(data.get('liveScore', null)) &&
        validCourts(courts, data.gameMode, players) &&
        validLockedPairs(data.get('lockedPartners', []), players) &&
        (data.gameMode == 'doubles' || data.get('lockedPartners', []).size() == 0) &&
        validPlayerSubset(data.get('sittingOut', []), players) &&
        validDoublesEngine(data.get('doublesEngineState', null), players) &&
        validSinglesEngine(data.get('singlesEngineState', null), players) &&
        (data.gameMode == 'doubles' || data.get('doublesEngineState', null) == null) &&
        (data.gameMode == 'singles' || data.get('singlesEngineState', null) == null) &&
        data.createdAt is timestamp && data.updatedAt is timestamp && data.lastActiveAt is timestamp;
    }

    function validSessionUpdate(data) {
      let players = data.players;
      let courts = data.get('courtSlots', []);
      let changed = data.diff(resource.data).affectedKeys();
      return data.keys().hasAll([
          'hostUid', 'revision', 'gameMode', 'queueMode', 'elimType',
          'players', 'queue', 'playAllRel', 'tournamentMatches',
          'tournamentActive', 'tournamentWinner',
          'createdAt', 'updatedAt', 'lastActiveAt'
        ]) &&
        data.keys().hasOnly([
          'hostUid', 'revision', 'gameMode', 'queueMode', 'elimType',
          'players', 'queue', 'playAllRel', 'tournamentMatches',
          'tournamentActive', 'tournamentWinner', 'liveScore', 'isLive',
          'accessPin', 'courtName', 'doublesEngineState', 'singlesEngineState',
          'courtSlots', 'lockedPartners', 'sittingOut',
          'createdAt', 'updatedAt', 'lastActiveAt'
        ]) &&
        data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
        data.revision is int && data.revision >= 0 && data.revision <= 1000000 &&
        data.gameMode in ['singles', 'doubles'] &&
        data.queueMode == 'default' && data.elimType == 'single' &&
        players is list && players.size() >= 5 && validPlayerRoster(players) &&
        data.playAllRel is map && data.playAllRel.size() == 0 &&
        data.tournamentMatches is list && data.tournamentMatches.size() == 0 &&
        data.tournamentActive == false && data.tournamentWinner == null &&
        data.get('isLive', false) is bool && data.get('accessPin', null) == null &&
        data.get('courtName', '') is string && data.get('courtName', '').size() <= 60 &&
        (!changed.hasAny(['queue']) || validPlayerSubset(data.queue, players)) &&
        (!changed.hasAny(['liveScore']) || validLiveScore(data.get('liveScore', null))) &&
        (!changed.hasAny(['courtSlots', 'gameMode']) || validCourts(courts, data.gameMode, players)) &&
        (!changed.hasAny(['lockedPartners', 'players', 'gameMode']) ||
          (validLockedPairs(data.get('lockedPartners', []), players) &&
           (data.gameMode == 'doubles' || data.get('lockedPartners', []).size() == 0))) &&
        (!changed.hasAny(['sittingOut']) || validPlayerSubset(data.get('sittingOut', []), players)) &&
        (!changed.hasAny(['doublesEngineState', 'players']) ||
          validDoublesEngineUpdate(data.get('doublesEngineState', null), players)) &&
        (!changed.hasAny(['singlesEngineState', 'players']) ||
          validSinglesEngineUpdate(data.get('singlesEngineState', null), players)) &&
        (data.gameMode == 'doubles' || data.get('doublesEngineState', null) == null) &&
        (data.gameMode == 'singles' || data.get('singlesEngineState', null) == null) &&
        data.createdAt is timestamp && data.updatedAt is timestamp && data.lastActiveAt is timestamp;
    }

    function validRevisionedStateUpdate(data) {
      let changed = data.diff(resource.data).affectedKeys();
      let courts = data.get('courtSlots', []);
      let players = data.players;
      return data.revision == resource.data.revision + 1 &&
        changed.hasOnly([
          'queue', 'courtSlots', 'doublesEngineState', 'singlesEngineState',
          'revision', 'updatedAt', 'lastActiveAt'
        ]) &&
        (!changed.hasAny(['queue']) || validPlayerSubset(data.queue, players)) &&
        (!changed.hasAny(['courtSlots']) || validCourts(courts, data.gameMode, players)) &&
        (!changed.hasAny(['doublesEngineState']) ||
          (data.get('doublesEngineState', null) == null ||
           (data.get('doublesEngineState', null) is map &&
            data.get('doublesEngineState', null).size() <= 12))) &&
        (!changed.hasAny(['singlesEngineState']) ||
          (data.get('singlesEngineState', null) == null ||
           (data.get('singlesEngineState', null) is map &&
            data.get('singlesEngineState', null).size() <= 7))) &&
        (data.gameMode == 'doubles' || data.get('doublesEngineState', null) == null) &&
        (data.gameMode == 'singles' || data.get('singlesEngineState', null) == null);
    }

    function validHistory(data, entryId) {
      return data.keys().hasAll(['id', 'mode', 'players', 'winner', 'timestamp', 'commandId', 'revision']) &&
        data.keys().hasOnly(['id', 'mode', 'players', 'winner', 'score', 'timestamp', 'commandId', 'revision']) &&
        data.id is int && data.id >= 0 && data.id <= 9999999999999999 &&
        data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 80 &&
        data.players is string && data.players.size() >= 1 && data.players.size() <= 500 &&
        data.winner is string && data.winner.size() >= 1 && data.winner.size() <= 130 &&
        data.get('score', '') is string && data.get('score', '').size() <= 40 &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 80 &&
        data.commandId is string && data.commandId == entryId &&
        data.commandId.matches('^[0-9a-fA-F-]{36}$') &&
        data.revision is int && data.revision > 0 && data.revision <= 1000000;
    }

    match /sessions/{sessionId} {
      allow get: if isAuthenticated() &&
        (resource == null || resource.data.hostUid == request.auth.uid ||
         resource.data.get('isLive', false) == true);
      allow list: if false;

      allow create: if isAuthenticated() && validRoomCode(sessionId) &&
        uidUnchanged(request.resource.data) && request.resource.data.revision == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastActiveAt == request.time &&
        validSession(request.resource.data);

      allow update: if isDocOwner() && uidNotModified(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.revision >= resource.data.revision &&
        request.resource.data.revision <= resource.data.revision + 1 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastActiveAt == request.time &&
        (validRevisionedStateUpdate(request.resource.data)
          ? true
          : validSessionUpdate(request.resource.data));

      allow delete: if isDocOwner();

      match /history/{entryId} {
        function parentPath() {
          return /databases/$(database)/documents/sessions/$(sessionId);
        }

        function parentOwned() {
          return isAuthenticated() && exists(parentPath()) &&
            get(parentPath()).data.hostUid == request.auth.uid;
        }

        allow get, list: if isAuthenticated() && exists(parentPath()) &&
          (get(parentPath()).data.hostUid == request.auth.uid ||
           get(parentPath()).data.get('isLive', false) == true);
        allow create: if isAuthenticated() &&
          getAfter(parentPath()).data.hostUid == request.auth.uid &&
          validHistory(request.resource.data, entryId) &&
          getAfter(parentPath()).data.revision == request.resource.data.revision;
        allow update: if false;
        allow delete: if parentOwned();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
